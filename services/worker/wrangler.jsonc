{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "faultspan-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-25",
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    { "binding": "KV", "id": "0588842f24cf4255aafaa76d30602a37" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "faultspan",
      "database_id": "f5a302f1-2828-4bbb-b249-8346528b62ec"
    }
  ],

  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,https://faultspan-web.vercel.app"
  }
}
